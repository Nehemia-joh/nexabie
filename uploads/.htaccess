# Uploaded files: never execute PHP here
<FilesMatch "\.(php|phtml|phar|cgi|pl)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
